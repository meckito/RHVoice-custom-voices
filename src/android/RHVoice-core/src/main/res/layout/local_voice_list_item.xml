<?xml version="1.0" encoding="utf-8"?>
<!-- Element listy glosow wlasnych.
     Dostepnosc: przelacznik i przycisk usuwania maja wlasne etykiety tekstowe,
     zeby czytnik ekranu ogloszil, czym sa, a nie tylko "przycisk". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp">
  <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">
    <TextView
        android:id="@+id/local_voice_name"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/android:textAppearanceListItem"/>
    <TextView
        android:id="@+id/local_voice_language"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
  </LinearLayout>
  <com.google.android.material.materialswitch.MaterialSwitch
      android:id="@+id/local_voice_enabled"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:focusable="true"/>
  <com.google.android.material.button.MaterialButton
      style="?attr/materialIconButtonStyle"
      android:id="@+id/local_voice_remove"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:focusable="true"
      android:contentDescription="@string/remove"
      app:iconSize="48dp"
      app:icon="@drawable/ic_delete"/>
</LinearLayout>
